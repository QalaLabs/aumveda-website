# ==============================================================================
# Aumveda - Google Cloud Run Environment Variables Template
# Set these variables in Cloud Run console or via Secret Manager
# ==============================================================================

# Node / Server Config
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=8080

# Database (PostgreSQL - Supabase / Neon / Cloud SQL)
# DATABASE_URL: Transaction Pooler connection string (port 6543)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session connection string (port 5432) for migrations
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Authentication
NEXTAUTH_URL="https://[YOUR-SERVICE-NAME]-[PROJECT-HASH]-[REGION].a.run.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"
NEXT_PUBLIC_APP_URL="https://[YOUR-SERVICE-NAME]-[PROJECT-HASH]-[REGION].a.run.app"

# Supabase Auth & Client
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJ..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# AI / Integrations
GEMINI_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# Email Configuration (SMTP)
EMAIL_SERVER_HOST="smtp.hostinger.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="support@aumveda.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Aumveda <support@aumveda.com>"

# Admin Notification Emails
PRACTITIONER_NOTIFY_EMAIL="practitioner@aumveda.com"
SEJAL_NOTIFY_EMAIL="sejal@aumveda.com"
ARCHANA_NOTIFY_EMAIL="archana@aumveda.com"
ADMIN_NOTIFY_EMAIL="admin@aumveda.com"

# Storage / Cloudflare R2 (Optional)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="aumveda-assets"
R2_PUBLIC_URL="https://assets.aumveda.com"

# Payment Gateways (Optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
