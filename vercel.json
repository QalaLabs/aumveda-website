{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm turbo run build --filter=@aumveda/web",
  "ignoreCommand": "npx turbo-ignore @aumveda/web",
  "crons": [
    {
      "path": "/api/cron/booking-comms",
      "schedule": "*/15 * * * *"
    }
  ]
}
