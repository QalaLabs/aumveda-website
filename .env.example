# ─── DATABASE ───────────────────────────────────────────────────────────────
# Neon.tech or Supabase PostgreSQL connection string
# Pooler — used by the app at runtime (port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# Direct — used by Prisma migrate only (port 5432, bypasses pgBouncer)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# ─── AUTH (NextAuth.js) ──────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link / verification) — use Resend, Nodemailer, or SendGrid
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@aumveda.com"

# ─── CLOUDFLARE R2 (Object Storage) ─────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="aumveda-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://assets.aumveda.com"

# ─── CASHFREE (Payments) ─────────────────────────────────────────────────────
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""
# "sandbox" or "production"
CASHFREE_ENV="sandbox"

# ─── OPENAI (AI Tips) ────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── PINECONE (Vector DB) ────────────────────────────────────────────────────
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="aumveda-journals"

# ─── UPSTASH REDIS (BullMQ + Rate Limiting) ──────────────────────────────────
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ─── API SERVER ──────────────────────────────────────────────────────────────
API_URL="http://localhost:3001"
# Internal secret used by web app to call API
API_INTERNAL_SECRET="generate-with: openssl rand -base64 32"

# ─── COURSES (JWT signing) ───────────────────────────────────────────────────
COURSE_JWT_SECRET="generate-with: openssl rand -base64 32"

# ─── HEALTH SYNC ─────────────────────────────────────────────────────────────
# AES-256 key for encrypting Google Fit refresh tokens (32 bytes, hex)
AES_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# ─── GOOGLE TAG MANAGER ──────────────────────────────────────────────────────
GTM_CONTAINER_ID="GTM-XXXXXXX"
GTM_SERVER_URL="https://api.aumveda.com/gtm"

# Meta Conversions API
META_PIXEL_ID=""
META_ACCESS_TOKEN=""

# GA4 Measurement Protocol
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# Pinterest Conversions
PINTEREST_AD_ACCOUNT_ID=""
PINTEREST_ACCESS_TOKEN=""

# ─── SUPABASE CLIENT ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── APP CONFIG ──────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── PORTAL — ASTROLOGY (Step 6: Constellation Mirror) ───────────────────────
# Prokerala OAuth2 client credentials (api.prokerala.com). Without these, Step 6
# falls back to a deterministic placeholder chart labeled `source: "fallback"`.
PROKERALA_CLIENT_ID=""
PROKERALA_CLIENT_SECRET=""

# Google Places API key, browser-side, restricted to this domain. Without it,
# Step 6's place-of-birth field is a plain text input (no autocomplete).
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# ─── PORTAL — BOOKING (Step 8: Discovery Call) ───────────────────────────────
# Calendly single-event-type scheduling URL, e.g. https://calendly.com/aumveda/discovery-call
# Without it, Step 8 shows a manual "Book My Free Discovery Call" button instead of the embed.
NEXT_PUBLIC_CALENDLY_URL=""

# n8n webhook that receives the full portal profile on completion (WhatsApp to
# Sejal, ClickUp lead card, email confirmation). Without it, the payload is
# logged to the Event table only — nothing is dispatched.
N8N_PORTAL_WEBHOOK_URL=""
