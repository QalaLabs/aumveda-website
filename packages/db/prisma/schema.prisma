// Aumveda — canonical Prisma schema
// DB: PostgreSQL (Neon.tech / Supabase)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooler (port 6543) — used at runtime
  directUrl = env("DIRECT_URL")         // direct (port 5432)  — used for migrations
}

// ─────────────────────────────────────────────────────────────
// NextAuth required models
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Core user models
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?   @db.Text
  googleId      String?   @unique
  role          String    @default("user") // "client" | "practitioner" | "admin" | "super_admin"
  
  // Auth Extensions
  otpCode                  String?
  otpExpires               DateTime?
  resetToken               String?
  resetTokenExpires        DateTime?
  verificationToken        String?
  verificationTokenExpires DateTime?
  
  // Birth chart / Astrology data
  dob           DateTime?
  birthLat      Float?
  birthLng      Float?
  placeOfBirth  String?
  timeOfBirth   String?
  risingSign    String?
  sunSign       String?
  moonSign      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // NextAuth relations
  accounts    Account[]
  sessions    Session[]

  // App relations
  profile     Profile?
  journals    Journal[]
  orders      Order[]
  achievements Achievement[]
  consents    Consent[]
  healthSyncs HealthSync[]
  healthMetrics HealthMetric[]
  dailyDoseCompletions DailyDoseCompletion[]
  progressSnapshots ProgressSnapshot[]
  enrolments  Enrolment[]
  courseProgress CourseProgress[]
  events      Event[]

  // Portal & Programs relations
  dailyDoseOverrides    DailyDoseOverride[]
  dailyDoseDeliveries   DailyDoseDelivery[]
  portalData            UserPortalData?
  bookings              Booking[]
  therapySessions       TherapySession[]
  packages              Package[]
  communityMember       CommunityMember?
  subscription          Subscription?
  challengeParticipations ChallengeParticipation[]
  contentViews          ContentView[]
  dailyCheckIns         DailyCheckIn[]
  clientHomework        ClientHomework[]
}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone        String   @default("Asia/Kolkata")
  avatarUrl       String?
  bio             String?  @db.Text
  progress        Float    @default(0)   // latest P_t value 0–100
  streakDays      Int      @default(0)
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Consent
// ─────────────────────────────────────────────────────────────

model Consent {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // e.g. "tracking", "health_sync", "marketing", "ai_personalization"
  value     Boolean
  version   String   // policy version: "v1", "v2" etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ─────────────────────────────────────────────────────────────
// Journals
// ─────────────────────────────────────────────────────────────

model Journal {
  id                  Int      @id @default(autoincrement())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String?
  body                String   @db.Text
  images              String[] // array of R2 image URLs
  voiceNoteUrl        String?  // R2 voice note url
  aiReflection        String?  @db.Text
  practitionerVisible Boolean  @default(true)
  mood                Int?     // 1–5 (1=difficult, 5=great)
  tags                String[] // user-defined tags
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Daily Dose
// ─────────────────────────────────────────────────────────────

model DailyDose {
  id          Int      @id @default(autoincrement())
  title       String
  audioKey    String   // R2 object key (not full URL — presign at request time)
  promptText  String   @db.Text
  durationSec Int
  isActive    Boolean  @default(true)
  publishDate DateTime
  createdAt   DateTime @default(now())

  completions DailyDoseCompletion[]
}

model DailyDoseCompletion {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doseId      Int
  dose        DailyDose @relation(fields: [doseId], references: [id])
  completedAt DateTime  @default(now())

  @@unique([userId, doseId])
}

// ─────────────────────────────────────────────────────────────
// Progress Engine
// ─────────────────────────────────────────────────────────────

// P_t = 0.35·S_t + 0.30·A_t + 0.25·J_t + 0.10·W_t
model ProgressSnapshot {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  score          Float    // overall P_t 0–100
  sleepScore     Float    @default(50) // S_t
  activityScore  Float    @default(0)  // A_t
  journalScore   Float    @default(0)  // J_t
  wellbeingScore Float    @default(50) // W_t (avg mood × 10)
  createdAt      DateTime @default(now())

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// Achievements / Badges
// ─────────────────────────────────────────────────────────────

model Achievement {
  id       Int      @id @default(autoincrement())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String   // "FIRST_JOURNAL" | "DAY_7" | "DAY_21" | "DAY_30" | "DAY_90" | "7_DAY_STREAK" | "SLEEP_IMPROVED" | "PROGRESS_50" | "PROGRESS_75"
  metadata Json?    // optional extra context
  earnedAt DateTime @default(now())

  @@unique([userId, key])
}

// ─────────────────────────────────────────────────────────────
// Health
// ─────────────────────────────────────────────────────────────

model HealthSync {
  id                   Int      @id @default(autoincrement())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String   // "google-fit" | "health-connect"
  encryptedAccessToken String?  @db.Text
  encryptedRefreshToken String? @db.Text
  tokenExpiresAt       DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, provider])
}

model HealthMetric {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricDate     DateTime @db.Date
  sleepMinutes   Int?
  sleepScore     Int?     // 0–100 derived
  steps          Int?
  workoutMinutes Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, metricDate])
}

// ─────────────────────────────────────────────────────────────
// E-Commerce
// ─────────────────────────────────────────────────────────────

model Product {
  id               Int      @id @default(autoincrement())
  sku              String   @unique
  slug             String   @unique
  title            String
  shortDescription String?  @db.Text
  description      String   @db.Text
  category         String   @default("")          // e.g. "Bracelets", "Vastu", "Crystals", "Combos", "Healing"
  priceCents       Int                                 // stored in paise (INR × 100)
  compareAtPriceCents Int?                             // MRP in paise — null means no strikethrough
  currency         String   @default("INR")
  images           String[]                            // R2 keys or external URLs
  inventoryCount   Int      @default(0)
  isActive         Boolean  @default(true)
  productType      String   @default("physical")      // "physical" | "course" | "digital"
  referenceId      Int?                                // courseId if productType === "course"
  tags             String[]                            // e.g. ["Bestseller", "Sale", "Bundle"]
  metadata         Json?                               // flexible key-value store
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems       OrderItem[]
}

model Order {
  id                Int       @id @default(autoincrement())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  status            String    @default("PENDING")
  // Fulfillment: PENDING → CONFIRMED → SHIPPED → DELIVERED | CANCELLED
  paymentStatus     String    @default("PENDING")
  // Payment:     PENDING → PAID | FAILED | REFUNDED
  totalCents        Int
  currency          String    @default("INR")
  eazebusOrderId    String?   @unique
  eazebusPaymentId  String?
  paymentMeta       Json?
  shippingAddress   Json?
  trackingNumber    String?
  customerEmail     String?
  customerName      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id])
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  sku        String
  title      String
  quantity   Int
  priceCents Int
}

// ─────────────────────────────────────────────────────────────
// Courses
// ─────────────────────────────────────────────────────────────

model Course {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String   @db.Text
  thumbnailKey String?  // R2 key
  isPaid       Boolean  @default(false)
  priceCents   Int?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules      Module[]
  enrolments   Enrolment[]
}

model Module {
  id          Int     @id @default(autoincrement())
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  ytVideoId   String
  orderIndex  Int
  durationSec Int?
  isPreview   Boolean @default(false)

  progress    CourseProgress[]
}

model Enrolment {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model CourseProgress {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    Int
  module      Module    @relation(fields: [moduleId], references: [id])
  completedAt DateTime?
  watchedSec  Int       @default(0)

  @@unique([userId, moduleId])
}

// ─────────────────────────────────────────────────────────────
// Server-side event log (append-only)
// ─────────────────────────────────────────────────────────────

model Event {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventName String
  // e.g. "journal.created" | "daily_dose.completed" | "purchase" | "sign_up"
  // | "ai.tips.generated" | "health_sync.completed" | "cashfree.webhook.unknown"
  payload   Json
  source    String   @default("server") // "client" | "server"
  forwarded Boolean  @default(false)    // true once relayed to GTM/ad platforms
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Portal & Astrological Models
// ─────────────────────────────────────────────────────────────

model DailyDoseOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceType    String
  instructionText String   @db.Text
  startsAt        DateTime
  durationDays    Int
  source          String?
  createdAt       DateTime @default(now())
}

model DailyDoseDelivery {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  contentJson    String    @db.Text
  deliveredAt    DateTime?
  openedAt       DateTime?
  completedAt    DateTime?
  channel        String    @default("whatsapp")
  deliveryStatus String    @default("pending")
  failureReason  String?
  overrideSource String?

  @@unique([userId, date])
}

model UserPortalData {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chakraSelected     String?
  archetypeSelected  String?
  tarotCard          String?
  tarotTheme         String?
  intentionText      String?   @db.Text
  q1Answer           String?
  q2Answer           String?
  q3Answer           String?
  q4Answer           String?
  q5Answer           String?
  q6Answer           String?
  q7Answer           String?
  nervousSystemScore String?
  relationshipScore  String?
  childhoodScore     String?
  financialScore     String?
  profileResult      String?
  portalCompletedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Booking {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  practitioner      String
  serviceType       String
  bookingDatetime   DateTime
  durationMinutes   Int
  status            String          @default("pending")
  amountPaid        Decimal         @default(0) @db.Decimal(10, 2)
  razorpayPaymentId String?
  zoomLink          String?
  calendlyEventId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  therapySession    TherapySession?
}

model TherapySession {
  id                        String    @id @default(cuid())
  bookingId                 String?   @unique
  booking                   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User      @relation(fields: [userId], references: [id])
  practitioner              String
  sessionDate               DateTime
  keyThemes                 String[]
  practicesAssigned         String[]
  nextSessionRecommendation String?   @db.Text
  distressFlag              Boolean   @default(false)
  recordingUrl              String?
  notesSubmittedAt          DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Package {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  packageType   String
  sessionsTotal Int
  sessionsUsed  Int       @default(0)
  amountPaid    Decimal   @db.Decimal(10, 2)
  purchasedAt   DateTime  @default(now())
  expiresAt     DateTime?
}

model CommunityMember {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                String   @default("free")
  joinedAt            DateTime @default(now())
  lastActiveAt        DateTime @default(now())
  circlesAttended     Int      @default(0)
  challengesCompleted Int      @default(0)
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  plan                   String
  amount                 Decimal  @db.Decimal(10, 2)
  startDate              DateTime @default(now())
  nextBillingDate        DateTime
  razorpaySubscriptionId String?
  status                 String   @default("active")
}

model LiveCircle {
  id                   String    @id @default(cuid())
  host                 String
  topic                String
  scheduledAt          DateTime
  zoomLink             String
  attendeeCount        Int       @default(0)
  recordingUrl         String?
  recordingAvailableAt DateTime?
  createdAt            DateTime  @default(now())
}

model Challenge {
  id             String                   @id @default(cuid())
  title          String
  durationDays   Int
  profileTargets String[]
  chakraTargets  String[]
  startDate      DateTime
  createdAt      DateTime                 @default(now())
  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id])
  enrolledAt    DateTime  @default(now())
  daysCompleted Int       @default(0)
  completedAt   DateTime?

  @@unique([userId, challengeId])
}

model ChakraReveal {
  id          String @id @default(cuid())
  chakraName  String @unique
  heading     String
  sub         String
  blockedText String @db.Text
  showsUpAs   String @db.Text
}

model ArchetypeReveal {
  id        String @id @default(cuid())
  name      String @unique
  icon      String
  gift      String @db.Text
  wound     String @db.Text
  showsUpAs String @db.Text
}

model TarotTheme {
  id        String   @id @default(cuid())
  themeName String   @unique
  message   String   @db.Text
  cardNames String[]
}

model ChartPrediction {
  id             String @id @default(cuid())
  placementType  String
  sign           String
  predictionText String @db.Text

  @@unique([placementType, sign])
}

model PatternQuestion {
  id           String @id @default(cuid())
  questionId   String @unique
  questionText String @db.Text
  dimension    String
  options      Json
}

model PatternScoring {
  id             String @id @default(cuid())
  questionId     String
  answer         String
  dimension      String
  dimensionValue String

  @@unique([questionId, answer])
}

model PatternProfile {
  id             String @id @default(cuid())
  profileName    String @unique
  nsMatch        String
  relMatch       String
  childhoodMatch String
  profileText    String @db.Text
}

model Reel {
  id              String    @id @default(cuid())
  title           String
  creatorName     String
  creatorHandle   String?
  muxAssetId      String
  healingModality String
  profileTags     String[]
  chakraTag       String?
  durationSeconds Int
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  approvedBy      String?
  createdAt       DateTime  @default(now())
}

model ContentView {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentType       String
  contentId         String
  viewedAt          DateTime @default(now())
  completionPercent Float?
}

// ─────────────────────────────────────────────────────────────
// Client Transformation Dashboard (Phase 1)
// ─────────────────────────────────────────────────────────────

/// Weekly cosmic guidance card shown at top of client dashboard
model CosmicNote {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  weekOf      DateTime  @db.Date
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Daily ritual check-in (under 5 min) — unique per user per calendar day
model DailyCheckIn {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  consciousThoughts String?   @db.Text
  gratitude         String?   @db.Text
  affirmationsDone  Boolean   @default(false)
  routinesDone      Boolean   @default(false)
  habitNote         String?   @db.Text
  beliefNote        String?   @db.Text
  journalNote       String?   @db.Text
  emotions          String[]  // e.g. ["calm", "hopeful"]
  oneChange         String?   @db.Text
  appreciation      String?   @db.Text
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Practitioner-assigned homework with client submission + review
model ClientHomework {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?   @db.Text
  status         String    @default("assigned") // assigned | submitted | reviewed
  assignedAt     DateTime  @default(now())
  dueAt          DateTime?
  submissionText String?   @db.Text
  submissionUrl  String?
  submittedAt    DateTime?
  reviewNote     String?   @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
}
